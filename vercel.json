{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "codex/playground-questions-and-swipes": false
    }
  },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "anandwedsusmita.vercel.app" }], "destination": "https://anandwedsusmita.in/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.anandwedsusmita.in" }], "destination": "https://anandwedsusmita.in/:path*", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!assets/|images/|favicon\\.svg|icon\\.svg|sw\\.js|workbox-|manifest\\.webmanifest|registerSW\\.js).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
