# Leave empty to run on the in-browser demo backend.
VITE_SITE_URL=https://anandwedsusmita.in
# Fill URL and one public key to use Supabase (Project Settings → API Keys).
VITE_SUPABASE_URL=
# Preferred for new Supabase projects:
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternatively use the legacy public anon key (never service_role):
VITE_SUPABASE_ANON_KEY=
